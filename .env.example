# ── Supabase (required) ─────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Public URL of the app. QR codes and e-mail links are built from it,
# so it must match what you deploy to.
VITE_APP_URL=http://localhost:5173

# ── Optional ────────────────────────────────────────────────
VITE_GOOGLE_MAPS_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=      # roadmap: online payments
VITE_VAPID_PUBLIC_KEY=            # roadmap: web push

# ── Edge function secrets ───────────────────────────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets,
# NOT in this file. Without a mail transport the platform still works:
# orders are placed and the store link is available in the admin
# dashboard, only the automatic e-mail is skipped.
#
# E-mail (notify-order, send-notification): SMTP via the product
# mailbox on the actionweb.gr mail server. See docs/EMAIL-SMTP.md.
# Port 465 (TLS): Supabase Edge blocks outbound 25 and 587.
#
# SMTP_HOST=mail.actionweb.gr
# SMTP_PORT=465
# SMTP_USER=delivr@actionweb.gr
# SMTP_PASS=
# SMTP_FROM=Delivr <delivr@actionweb.gr>
# SMTP_SECURE=                    # optional; default true when port is 465
#
# Fallback only (used when SMTP_* is not set):
# RESEND_API_KEY=
# RESEND_FROM=
#
# Store plans paid by card (migration 019, functions plan-billing +
# stripe-webhook). Without them every paid plan shows «σύντομα».
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...        # 39 € / month, EUR, tax-exclusive
# STRIPE_PRICE_PLUS=price_...       # 79 € / month
# STRIPE_PRICE_PREMIUM=price_...    # 150 € / month
# STRIPE_TAX_RATE_ID=txr_...        # ΦΠΑ 24 % exclusive  (or STRIPE_AUTOMATIC_TAX=true)
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...   # optional: customer portal configuration
#
# Roadmap (WhatsApp API):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
