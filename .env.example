# ── Supabase (required) ─────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Public URL of the app. QR codes and e-mail links are built from it,
# so it must match what you deploy to.
VITE_APP_URL=http://localhost:5173

# ── Optional ────────────────────────────────────────────────
VITE_GOOGLE_MAPS_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=      # roadmap: online payments
VITE_VAPID_PUBLIC_KEY=            # roadmap: web push

# ── Edge function secrets ───────────────────────────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets,
# NOT in this file. Without RESEND_API_KEY the platform still works:
# orders are placed and the store link is available in the admin
# dashboard, only the automatic e-mail is skipped.
#
# RESEND_API_KEY=re_...
# RESEND_FROM=Delivr <orders@yourdomain.com>
#
# Roadmap (online payments / WhatsApp API):
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
